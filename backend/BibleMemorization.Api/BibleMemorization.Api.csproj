<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Transitive pin: CVE-2026-49451 (GHSA-v5pm-xwqc-g5wc) affects <= 2.7.4; 2.7.5 is the first patch. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the static catalog with the published output (Update: already included by the Web SDK). -->
    <Content Update="Data\catalog.v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
